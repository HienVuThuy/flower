APP_NAME="Flower & Plant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Chay that qua HTTPS thi bat len: cookie phien chi gui qua ket noi ma hoa.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================
# EMAIL
# =============================================================
# MAIL_MAILER=log nghia la thu KHONG duoc gui di dau ca, chi ghi vao
# storage/logs/laravel.log. De nguyen nhu vay khi dang lam viec tren may
# ca nhan: khong lo lo tay gui thu that cho khach.
#
# Giao dien BIET dieu do: App\Services\Order\OrderMailer::deliversForReal()
# tra ve false voi cac mailer log/array/null, nen trang don hang se KHONG
# noi "da gui email xac nhan" khi thu chua thuc su di. Xem QD-04.
#
# DE GUI THAT, doi MAIL_MAILER=smtp roi dien thong tin nha cung cap.
#
# MAIL_FROM_ADDRESS PHAI thuoc ten mien ma cua hang so huu.
# Day KHONG phai tuy chon lam dep: Gmail va Outlook kiem tra SPF/DKIM cua
# ten mien trong dia chi nguoi gui. Dat mot dia chi khong thuoc ten mien
# minh quan ly (vi du de nguyen example.com ben duoi) thi thu se roi
# thang vao hom Spam, hoac bi tu choi hoan toan.
#
# Dia chi lien he cua cua hang (admin nhap trong Cai dat) duoc dung lam
# Reply-To, KHONG dung lam From - vi ly do SPF vua noi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@doi-thanh-ten-mien-cua-ban.vn"
MAIL_FROM_NAME="${APP_NAME}"

# MAIL_QUEUE=true day thu ra bang `jobs` thay vi gui ngay trong request.
# Admin doi trang thai hang loat se khong phai cho ket noi SMTP tung don.
#
# BAT CO NAY THI PHAI CHAY KEM MOT TIEN TRINH:
#     php artisan queue:work
# Khong co worker thi thu nam im trong bang `jobs` mai mai — khong loi,
# khong canh bao, chi la khach khong bao gio nhan duoc thu.
MAIL_QUEUE=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================================
# GIAO HÀNG NHANH (GHN)
# ==========================================================
# Lấy Token và ShopID sau khi tạo tài khoản ở môi trường thử:
#   https://5sao.ghn.dev/
#
# GHN_FROM_DISTRICT_ID là quận/huyện GỬI hàng — tra bằng lệnh:
#   php artisan ghn:tra-dia-chi "Hà Nội"
#
# GHN_VERIFY_SSL=false CHỈ cho máy phát triển (XAMPP trên Windows thường
# thiếu bộ chứng chỉ gốc). Trên máy chủ thật phải để true.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_VERIFY_SSL=false
GHN_FROM_DISTRICT_ID=

# TRANG TRA CỨU CÔNG KHAI CỦA GHN — để trống ở môi trường THỬ.
#
# Đo được 10/09/2026: vận đơn tạo trên cổng dev-online-gateway KHÔNG tra
# được ở donhang.ghn.vn (trang của môi trường THẬT). Khách nhập đúng 4 số
# cuối vẫn nhận "Thông tin không chính xác" vì trang đó không biết mã vận
# đơn kia tồn tại. Để trống thì giao diện không hiện nút — một đường dẫn
# luôn báo sai còn tệ hơn không có đường dẫn.
#
# Khi chuyển sang khoá thật:  GHN_TRACKING_URL=https://donhang.ghn.vn/
GHN_TRACKING_URL=

# ============================================================
# TRỢ LÝ AI (Plant & Shopping Advisor)
# ============================================================
# Lấy khoá ở Google AI Studio. KHÔNG ghi khoá vào mã, KHÔNG commit file .env.
# Để trống thì khung chat hiện "Trợ lý AI chưa được cấu hình" và không gọi
# ra ngoài.
#
# GEMINI_VERIFY_SSL=false CHỈ cho máy phát triển (cùng lý do với GHN).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VERIFY_SSL=true

# ============================================================
# MOMO — CỔNG THANH TOÁN
# ============================================================
# Bộ khoá dưới đây là khoá MÔI TRƯỜNG THỬ do MoMo công bố công khai cho
# lập trình viên, dùng chung cho mọi người — không phải khoá riêng của
# cửa hàng. MoMo chỉ cấp khoá thật cho tài khoản doanh nghiệp.
#
# MOMO_REQUEST_TYPE quyết định trang MoMo mở ra loại nào, và phải khớp
# với loại thẻ đem thử:
#
#   payWithCC   thẻ QUỐC TẾ (đang dùng)
#       5200 0000 0000 1096   hạn 05/26   CVC 111   OTP trên màn hình
#
#   payWithATM  thẻ NỘI ĐỊA, hạn 12/30, OTP trên màn hình
#       9704 0000 0000 0018  thành công
#       9704 0000 0000 0026  thẻ khoá
#       9704 0000 0000 0034  không đủ tiền
#       9704 0000 0000 0042  quá hạn mức
#
# Đo được 10/09/2026: payWithATM trên môi trường thử đứng mãi ở màn hình
# "Đang tải dữ liệu giao dịch" — MoMo từ chối dịch vụ nội địa. payWithCC
# cùng bộ khoá đó hiện form thẻ bình thường.
#
# MOMO_IPN_URL: MoMo gọi từ Internet vào, nên localhost KHÔNG nhận được.
# Để trống khi học ở nhà — luồng vẫn chạy nhờ trang callback. Muốn thử
# IPN thật thì mở ngrok rồi điền URL công khai vào đây.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2bsa
MOMO_REQUEST_TYPE=payWithCC
MOMO_VERIFY_SSL=false
MOMO_REDIRECT_URL=
MOMO_IPN_URL=


# Duong dan toi mysqldump cho lenh sao-luu:csdl (de trong neu may da co san trong PATH).
# Tren Windows dung dau gach xuoi, vi du: MYSQLDUMP_PATH="D:/xampp/mysql/bin/mysqldump.exe"
MYSQLDUMP_PATH=
